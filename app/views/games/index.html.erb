<section class="mb-10 text-center">
  <h1 class="text-4xl font-black tracking-tight sm:text-5xl">Pokémon Games</h1>
  <p class="mt-3 text-lg text-base-content/70">Two quick games for Pokémon fans. Pick one and play.</p>
</section>

<div class="grid gap-6 sm:grid-cols-2">
  <%= link_to games_guess_that_pokemon_path, class: "card group overflow-hidden bg-base-100 shadow-md transition hover:-translate-y-1 hover:shadow-xl" do %>
    <figure class="aspect-video bg-stage">
      <%= image_tag "guess_that_pokemon.webp", alt: "", class: "size-full object-cover transition duration-500 group-hover:scale-105" %>
    </figure>
    <div class="card-body">
      <h2 class="card-title text-2xl">Guess That Pokémon</h2>
      <p class="text-base-content/70">Name the Pokémon from its silhouette, just like the TV show.</p>
      <div class="card-actions justify-end">
        <span class="btn btn-primary">Play</span>
      </div>
    </div>
  <% end %>

  <%= link_to games_concentrations_path, class: "card group overflow-hidden bg-base-100 shadow-md transition hover:-translate-y-1 hover:shadow-xl" do %>
    <figure class="flex aspect-video items-center justify-center gap-3 bg-linear-to-br from-secondary to-stage">
      <% [ "-rotate-12 translate-y-2", "z-10 -translate-y-1", "rotate-12 translate-y-2" ].each do |tilt| %>
        <%= image_tag "pokemon_card_backside.webp", alt: "", class: "h-2/3 rounded-lg shadow-lg transition duration-500 group-hover:scale-105 #{tilt}" %>
      <% end %>
    </figure>
    <div class="card-body">
      <h2 class="card-title text-2xl">Concentration</h2>
      <p class="text-base-content/70">Flip trading cards two at a time and find every matching pair.</p>
      <div class="card-actions justify-end">
        <span class="btn btn-primary">Play</span>
      </div>
    </div>
  <% end %>
</div>
